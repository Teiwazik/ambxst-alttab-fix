diff -ruN a/modules/services/WindowSwitcher.qml b/modules/services/WindowSwitcher.qml
--- a/modules/services/WindowSwitcher.qml	1970-01-01 01:00:00.000000000 +0100
+++ b/modules/services/WindowSwitcher.qml	2026-11-01 11:03:56.264357755 +0100
@@ -0,0 +1,198 @@
+pragma Singleton
+
+import QtQuick
+import Quickshell
+import Quickshell.Io
+import qs.modules.globals
+
+// Windows style Alt+Tab session. A quick tap switches without any UI, the list
+// appears only while Alt stays held, and releasing Alt commits the selection.
+Singleton {
+    id: root
+
+    readonly property int showDelay: 70
+    // A preview that never arrives must not hold the list back for long.
+    readonly property int previewWait: 130
+
+    property bool session: false
+    property bool shown: false
+    // The overlay maps invisibly at session start so previews are ready when it appears.
+    property bool delayPassed: false
+    property bool previewsReady: false
+    property bool previewWaitOver: false
+    readonly property bool revealed: shown && delayPassed && (previewsReady || previewWaitOver)
+    property var windows: []
+    property int selectedIndex: 0
+
+    // Most recently used addresses, resynced from the compositor shortly after focus changes.
+    property var mru: []
+    property int sessionCount: 0
+    property real closedAt: 0
+    property string lastFocused: ""
+
+    function touch(address) {
+        if (address) root.mru = [address].concat(root.mru.filter(a => a !== address));
+    }
+
+    function snapshot() {
+        const clients = (AxctlService.clients.values || []).filter(c => c.workspace && c.workspace.id !== 0);
+        const rank = address => {
+            const i = root.mru.indexOf(address);
+            return i === -1 ? root.mru.length : i;
+        };
+        return clients.slice().sort((a, b) => rank(a.address) - rank(b.address));
+    }
+
+    function step(direction) {
+        if (!root.session) {
+            const list = root.snapshot();
+            if (list.length < 2) return;
+            root.windows = list;
+            root.selectedIndex = 0;
+            root.session = true;
+            root.sessionCount++;
+            syncTimer.stop();
+            root.delayPassed = false;
+            root.previewsReady = false;
+            root.previewWaitOver = false;
+            root.shown = true;
+            Visibilities.setActiveModule("overview");
+            showTimer.restart();
+            previewWaitTimer.restart();
+        }
+        const n = root.windows.length;
+        root.selectedIndex = (root.selectedIndex + direction + n) % n;
+        if (earlyAcceptTimer.running) {
+            earlyAcceptTimer.stop();
+            root.accept();
+        }
+    }
+
+    function accept(index) {
+        if (!root.session) {
+            // Binds spawn separate processes, a very quick release can overtake its Tab.
+            // Right after a session this is only the second notice of the same release.
+            if (Date.now() - root.closedAt > 200) earlyAcceptTimer.restart();
+            return;
+        }
+        const target = root.windows[index === undefined ? root.selectedIndex : index];
+        const wasRevealed = root.revealed;
+        root.close();
+        if (!target) return;
+        // Update now so the next tap is correct before the focus event arrives.
+        root.touch(target.address);
+        if (wasRevealed) {
+            // Focusing before the overlay is gone bounces back to the previous window.
+            refocusTimer.address = target.address;
+            refocusTimer.restart();
+        } else {
+            AxctlService.dispatch(`focuswindow address:${target.address}`);
+        }
+    }
+
+    function cancel() {
+        if (root.session) root.close();
+    }
+
+    function close() {
+        showTimer.stop();
+        previewWaitTimer.stop();
+        root.session = false;
+        root.closedAt = Date.now();
+        syncTimer.restart();
+        if (root.shown) {
+            // Close first: with the overlay still open the Loader would swap to the workspace overview.
+            if (Visibilities.currentActiveModule === "overview") Visibilities.setActiveModule("");
+            root.shown = false;
+        }
+    }
+
+    // The overlay was closed from outside, for example by a click on the backdrop.
+    function overlayClosed() {
+        if (root.shown) {
+            root.shown = false;
+            root.cancel();
+        }
+    }
+
+    Timer {
+        id: showTimer
+        interval: root.showDelay
+        onTriggered: root.delayPassed = true
+    }
+
+    Timer {
+        id: previewWaitTimer
+        interval: root.previewWait
+        onTriggered: root.previewWaitOver = true
+    }
+
+    Timer {
+        id: earlyAcceptTimer
+        interval: 150
+    }
+
+    Timer {
+        id: refocusTimer
+        property string address: ""
+        interval: 40
+        onTriggered: AxctlService.dispatch(`focuswindow address:${address}`)
+    }
+
+    Connections {
+        target: AxctlService
+        function onFocusedClientChanged() {
+            const address = AxctlService.focusedClient?.address;
+            if (!address || address === root.lastFocused) return;
+            root.lastFocused = address;
+            if (refocusTimer.running) return;
+            root.touch(address);
+            // Quick focus changes can skip windows here, the compositor has the full order.
+            if (!root.session) syncTimer.restart();
+        }
+    }
+
+    Connections {
+        target: AxctlService.clients
+        function onValuesChanged() {
+            if (!root.session) return;
+            const alive = (AxctlService.clients.values || []).map(c => c.address);
+            const selected = root.windows[root.selectedIndex]?.address;
+            const list = root.windows.filter(w => alive.includes(w.address));
+            if (list.length === root.windows.length) return;
+            root.windows = list;
+            if (list.length < 2) {
+                root.cancel();
+                return;
+            }
+            root.selectedIndex = Math.max(0, list.findIndex(w => w.address === selected));
+        }
+    }
+
+    Timer {
+        id: syncTimer
+        interval: 300
+        onTriggered: {
+            historyReader.startedAt = root.sessionCount;
+            historyReader.running = true;
+        }
+    }
+
+    Process {
+        id: historyReader
+        // A reply from before the latest session is stale and must be dropped.
+        property int startedAt: 0
+        running: true
+        command: ["hyprctl", "-j", "clients"]
+        stdout: StdioCollector {
+            onStreamFinished: {
+                try {
+                    if (historyReader.startedAt !== root.sessionCount) return;
+                    root.mru = JSON.parse(text).sort((a, b) => a.focusHistoryID - b.focusHistoryID).map(c => c.address);
+                } catch (e) {
+                    console.warn("WindowSwitcher: no focus history", e);
+                }
+            }
+        }
+    }
+}
